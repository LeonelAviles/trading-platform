# Copy to backend/.env and fill in your own values. .env is gitignored;
# this file is the committed template, so keep placeholders here only.
#
# backend/main.py loads .env at startup, before anything reads these.

# --- Required ---------------------------------------------------------------
# Anthropic API key. Without it the app still runs — charts, manual strategies
# and backtests all work — but POST /api/strategies/generate and the chat
# analyst return 400 "not configured".
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Optional ---------------------------------------------------------------
# Model behind strategy generation and the chat analyst.
# Default: claude-sonnet-5. Use claude-opus-5 for harder tuning runs.
ANTHROPIC_MODEL=claude-sonnet-5

# Postgres for the strategy/backtest metadata tables (backend/models.py).
# Default: the local Postgres.app cluster over the /tmp unix socket.
# DATABASE_URL=postgresql+psycopg://postgres@/stratify?host=/tmp

# Where the Hermes plugin looks for this backend. Only read by the Hermes
# process (backend/hermes_plugin/client.py), NOT by this .env — export it in
# the shell you run `hermes` from. Its built-in default is port 8000, which is
# wrong for this repo; the API runs on 8123.
# TRADING_API_URL=http://127.0.0.1:8123
