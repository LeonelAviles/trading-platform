# Copy to backend/.env and fill in your own values. .env is gitignored;
# this file is the committed template, so keep placeholders here only.
#
# backend/app.py loads .env at startup, before anything reads these. Anything
# already exported in the shell wins over the file.

# --- Platform metadata ---------------------------------------------------
# Existing SQLite data must be transferred before switching an established app.
# See docs/09-postgresql.md for pgloader, verification and cutover.
# PostgreSQL: postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/trading_platform
# SQLite remains available for standalone development/tests:
# Relative sqlite paths resolve against the repo root, so this is
# <repo>/data/platform.db whether uvicorn runs from backend/ or the root.
DATABASE_URL=sqlite+pysqlite:///./data/platform.db

# --- Market data tiers (PLATFORM-SPEC.md §4.1) ------------------------------
# LRU cap for data/replay_cache (full decoded MBO days used by tick replay).
REPLAY_CACHE_MAX_GB=20
# Derived data root (default <repo>/data) and raw root (default <repo>/market-data).
# DATA_DIR=./data
# MARKET_DATA_DIR=./market-data
# DuckDB memory cap for the API process and ingest (8.6 GB machine: keep 2GB).
DUCKDB_MEMORY_LIMIT=2GB

# Raw .dbn.zst archive to S3 (scripts/archive.py / scripts/restore.py).
S3_BUCKET=
S3_PREFIX=trading-platform/raw
S3_STORAGE_CLASS=GLACIER_IR
AWS_PROFILE=default

# --- Stratos Research agent -------------------------------------------------
# Create a project API key in the OpenAI dashboard. Never commit a real key.
OPENAI_API_KEY=
# Flagship reasoning model with function and file-search support.
OPENAI_MODEL=gpt-6-astra

# Prepared ML features (separate from application metadata; no SQLite fallback).
# Use a PostgreSQL DSN, not SQLAlchemy's postgresql+psycopg scheme.
# Set up tables explicitly with scripts/import_mbo_features.py --initialize.
# FEATURE_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/trading_features
# Finite relation budget, including indexes and TOAST (default 1 GiB).
FEATURE_STORE_MAX_BYTES=1073741824
# Local extraction safety floor; database volume requires separate monitoring.
FEATURE_MIN_FREE_GIB=2
