# Copy to backend/.env and fill in your own values. .env is gitignored;
# this file is the committed template, so keep placeholders here only.
#
# backend/app.py loads .env at startup, before anything reads these. Anything
# already exported in the shell wins over the file.

# --- LLM (Anthropic only) --------------------------------------------------
# Without a key the app still runs — charts, manual strategies and backtests
# all work — but strategy generation, the chat analyst and research return
# 400 "not configured".
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Reasoning model: strategy generation, experiment planning, teaching
# hypotheses/questions, chat. Fast model: source scoring, summaries,
# snapshot tagging, classification. (PLATFORM-SPEC.md §4.9)
ANTHROPIC_MODEL_REASONING=claude-sonnet-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
# Legacy alias still honoured by agent_llm.py until Phase 4 replaces it.
ANTHROPIC_MODEL=claude-sonnet-5

# Budget guard (USD). At 95% of the monthly budget agent runs pause.
LLM_MONTHLY_BUDGET_USD=100
LLM_DAILY_RESEARCH_BUDGET_USD=1.50

# --- Platform metadata (SQLite, PLATFORM-SPEC.md §4.7) ---------------------
# Relative sqlite paths resolve against the repo root, so this is
# <repo>/data/platform.db whether uvicorn runs from backend/ or the root.
DATABASE_URL=sqlite+pysqlite:///./data/platform.db

# --- Knowledge graph (Neo4j via docker-compose, Phase 4) -------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j

# --- Market data tiers (PLATFORM-SPEC.md §4.1) ------------------------------
# LRU cap for data/replay_cache (full decoded MBO days used by tick replay).
REPLAY_CACHE_MAX_GB=20

# Raw .dbn.zst archive to S3 (scripts/archive.py / scripts/restore.py).
S3_BUCKET=
S3_PREFIX=trading-platform/raw
S3_STORAGE_CLASS=GLACIER_IR
AWS_PROFILE=default

# --- Hermes plugin ----------------------------------------------------------
# Only read by the Hermes process (backend/hermes_plugin/client.py), NOT by
# this .env — export it in the shell you run `hermes` from. Its built-in
# default is port 8000, which is wrong for this repo; the API runs on 8123.
# TRADING_API_URL=http://127.0.0.1:8123
