      "doc": "1 when the last closed bar traded at least `min_volume` contracts aggressively into `side`\n(bid: sellers hitting bids; ask: buyers lifting offers) while the bar's range stayed within\n`max_range_ticks` \u2014 heavy volume that failed to move price.",
      "mirror": "none",
      "name": "absorption",
      "output": "bool",
      "params": {
        "max_range_ticks": {
          "default": 3,
          "doc": "bar range cap in ticks",
          "required": false,
          "type": "int"
        },
        "min_volume": {
          "default": 500,
          "doc": "contracts",
          "required": false,
          "type": "int"
        },
        "side": {
          "choices": [
            "bid",
            "ask"
          ],
          "default": "bid",
          "doc": "bid | ask",
          "required": false,
          "type": "str"
        }
      },
      "tfCapable": false,
      "updateOn": "trade"
    },
    {
